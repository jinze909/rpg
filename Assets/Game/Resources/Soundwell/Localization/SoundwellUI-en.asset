  - m_Id: 94572955267314
    m_Localized: "BEAST  /  SEARCHING"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267315
    m_Localized: "BEAST  /  RETURNING"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267316
    m_Localized: "BEAST  /  LISTENING"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267317
    m_Localized: "GATE  /  OPEN"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267318
    m_Localized: "GATE  /  LOCKED"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267319
    m_Localized: "ESCAPE LANE  /  BLOCKED"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267320
    m_Localized: "ESCAPE LANE  /  CLEAR"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267321
    m_Localized: "Guard self"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267322
    m_Localized: "Open gate"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267323
    m_Localized: "GUARDING"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267324
    m_Localized: "ENGAGE BEAST [G / RB]"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267325
    m_Localized: "INSPECT ROPE [G / RB]"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267326
    m_Localized: "RECOVER CORD [G / RB]"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267327
    m_Localized: "INSPECT CART [G / RB]"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267328
    m_Localized: "TELL ABOUT CART [G / RB]"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267329
    m_Localized: "INSPECT CLAWS [G / RB]"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267330
    m_Localized: "TIE GUIDE LINE [G / RB]"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267331
    m_Localized: "LEAD SURVEYOR [G / RB]"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267332
    m_Localized: "BRACE PLANK [G / RB]"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267333
    m_Localized: "ASK SURVEYOR [G / RB]"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267334
    m_Localized: "OPEN GATE [G / RB]"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267335
    m_Localized: "SURVEYOR: Safe at last. My marker was wrong; I'll take it down myself."
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267336
    m_Localized: "RESCUED: The surveyor reached RETREAT. He'll remove his false trail marker."
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267337
    m_Localized: "SURVEYOR: Beast at the gate! Draw it toward the SIDE BELL STAND."
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267338
    m_Localized: "SURVEYOR: Too far ahead! Come back and lead me to RETREAT."
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267339
    m_Localized: "ESCAPE BLOCKED: Lure the beast away from the gate with the SIDE BELL STAND."
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267340
    m_Localized: "ESCORT PAUSED: Return to the surveyor, then lead him toward RETREAT."
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267341
    m_Localized: "SURVEYOR: Show me the way through the gate. I'll wait on this plank."
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267342
    m_Localized: "SURVEYOR: Keep the gate open. I'm right behind you."
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267343
    m_Localized: "Lead through the open gate first. The surveyor is waiting for you."
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267344
    m_Localized: "SURVEYOR: Stop! The lower plank won't hold you."
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267345
    m_Localized: "SURVEYOR: That upper board holds two. My marker misled you; I'll take it down."
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267346
    m_Localized: "SURVEYOR: The upper plank holds. I can cross now—don't leave me here."
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267347
    m_Localized: "SURVEYOR: The lower plank snapped! Ask me about the safe upper route."
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267348
    m_Localized: "BEAST CONTACT: Pushed back to RETREAT. The gate remains open; choose a safer route."
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267349
    m_Localized: "DIRECT ROUTE: Engage the ORK party, or lure the beast toward the SIDE BELL STAND."
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267350
    m_Localized: "DIRECT ROUTE: Engage the beast with the ORK party, or inspect nearby tracks for another approach."
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267351
    m_Localized: "BEAST DEFEATED: The three-member ORK party cleared the inner lane. Open the gate."
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267352
    m_Localized: "[F / LB] Place the bell on this marked stand to set its sound source."
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267353
    m_Localized: "Carry the bell to the ENTRANCE or SIDE BELL STAND. No free drops."
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267354
    m_Localized: "[G / RB] Inspect the torn bell cord."
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267355
    m_Localized: "[G / RB] Recover the usable cord for a guide line."
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267356
    m_Localized: "You recovered the usable cord for the surveyor."
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267357
    m_Localized: "[G / RB] Inspect the abandoned mule cart."
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267358
    m_Localized: "The cart tracks point toward the inner gate."
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267359
    m_Localized: "[G / RB] Inspect the beast's claw tracks."
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267360
    m_Localized: "The revealed claw trail runs toward the SIDE BELL STAND. The beast still needs a sound to follow."
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267361
    m_Localized: "MOVE"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267362
    m_Localized: "NORTH"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267363
    m_Localized: "EAST"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267364
    m_Localized: "SOUTH"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267365
    m_Localized: "WEST"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267366
    m_Localized: "Confirm step"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267367
    m_Localized: "CANCEL STEP"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267368
    m_Localized: "SURVEYOR: My map kit is safe. The verified route is posted where the false sign stood."
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267369
    m_Localized: "SURVEYOR: My map kit is safe. I'll mark the correct route by my old sign."
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267370
    m_Localized: "SURVEYOR: I've taken down that false trail sign. You found my cart; I'll get my map kit."
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267371
    m_Localized: "SURVEYOR: My marker was wrong. I've taken down that false trail sign."
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267372
    m_Localized: "OBSERVED: The abandoned cart was dragged to the gate; its tracks lead inside."
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267373
    m_Localized: "OBSERVED: The bell cord was cut. A rough knot remains."
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267374
    m_Localized: "OBSERVED: Claw marks turn toward the bell stand, not RETREAT."
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267375
    m_Localized: "SAFE ROUTE POSTED: The surveyor replaced his false marker with a verified route."
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267376
    m_Localized: "MAP KIT RECOVERED: The surveyor is returning to post the safe route."
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267377
    m_Localized: "ROUTE CORRECTED: [G / RB] Tell the surveyor about his cart, or leave it for now."
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267378
    m_Localized: "ROUTE CORRECTED: You can tell the surveyor about his cart when nearby."
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267379
    m_Localized: "ROUTE CORRECTED: The surveyor is returning to the cart for his map kit."
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267380
    m_Localized: "ROUTE CORRECTED: The surveyor removed the false trail marker himself."
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267381
    m_Localized: "[G / RB] Tie the recovered cord to guide the surveyor. Rescue not complete."
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267382
    m_Localized: "[G / RB] Lead the surveyor through the gate. Rescue not complete."
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267383
    m_Localized: "Upper plank braced; surveyor can stand on it. Rescue not complete."
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267384
    m_Localized: "[G / RB] Brace the upper plank for the surveyor."
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267385
    m_Localized: "Ask the surveyor which plank is safe before bracing anything."
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267386
    m_Localized: "Upper plank marked. The surveyor is still trapped; brace it before he can cross."
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267387
    m_Localized: "[G / RB] Ask the surveyor which plank can carry someone."
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267388
    m_Localized: "Escort the surveyor through the open gate to RETREAT."
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267389
    m_Localized: "Gate open: cross into the soundwell inner room."
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267390
    m_Localized: "[G / RB] Open the gate while the beast follows the side bell."
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267391
    m_Localized: "Move the bell to the SIDE STAND and draw the beast away to open this gate."
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267392
    m_Localized: "The beast guards this gate. Look for evidence of what draws its attention."
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267393
    m_Localized: "[E / Pad A] Try the wrapped bell   [Q / Pad X] Remove the cloth"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267394
    m_Localized: "[E / Pad A] Ring the bell   [Q / Pad X] Wrap with the wet cloth   [F / LB] Lift"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267395
    m_Localized: "[R / Pad Y] Reset the experiment"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267396
    m_Localized: "Lead the surveyor to RETREAT. Do not leave him behind."
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267397
    m_Localized: "Return to RETREAT to reset the experiment."
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267398
    m_Localized: "Walk to the copper bell. Watch the beast beyond the grate."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
