    m_Localized: "\u4FA7\u8FB9\u94C3\u67B6"
    m_Metadata:
      m_Items: []
  - m_Id: 797937667
    m_Localized: "[WASD / \u65B9\u5411\u952E / \u6447\u6746] \u79FB\u52A8    [Esc / B] \u8FD4\u56DE\u5165\u53E3"
    m_Metadata:
      m_Items: []
  - m_Id: 797937668
    m_Localized: "TAB / START\uFF1A\u9009\u62E9\u64CD\u4F5C"
    m_Metadata:
      m_Items: []
  - m_Id: 797937669
    m_Localized: "\u64CD\u4F5C\u9009\u62E9 / \u65B9\u5411\u952E\uFF1A\u9009\u62E9 / Enter \u6216 A\uFF1A\u786E\u8BA4 / Esc \u6216 B\uFF1A\u8FD4\u56DE"
    m_Metadata:
      m_Items: []
  - m_Id: 797937670
    m_Localized: "\u6447\u94C3 [E / A]"
    m_Metadata:
      m_Items: []
  - m_Id: 797937671
