    m_Localized: "ORK \u56DE\u5408\u6218 / \u5360\u4F4D"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267072
    m_Localized: "\u6551\u63F4\u961F\u5458"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267073
    m_Localized: "\u91CE\u517D"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267074
    m_Localized: "\u751F\u547D"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267075
    m_Localized: "< \u884C\u52A8"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267076
    m_Localized: "\u5F53\u524D\u6CA1\u6709\u53EF\u7528\u7684\u653B\u51FB\u6307\u4EE4\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267077
    m_Localized: "\u64A4\u79BB [Esc / B]"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267300
    m_Localized: "声井 / 信号试炼"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267301
    m_Localized: "[F2 / 手柄 A] 进入试炼"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267302
    m_Localized: "点击 / Enter / 手柄 A 开始"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267303
    m_Localized: "测路人获救 / 错误路标已移除"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267304
    m_Localized: "测路人获救 / 错误路标仍待纠正"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267305
    m_Localized: "\n地图工具已取回"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267306
    m_Localized: "\n安全返程路线已标记"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267307
    m_Localized: "\n遭遇野兽次数：{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267308
    m_Localized: "\n无接触撤离：未与野兽接触"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267309
    m_Localized: "撤退 / 遭遇野兽次数：{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267310
    m_Localized: "音效开启 / 点击静音"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267311
    m_Localized: "音效已静音 / 点击开启"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267312
    m_Localized: "野兽 / 已击败"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267313
    m_Localized: "野兽 / 追踪声源"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267314
    m_Localized: "野兽 / 搜寻中"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267315
    m_Localized: "野兽 / 返回中"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267316
    m_Localized: "野兽 / 监听中"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267317
    m_Localized: "闸门 / 已开启"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267318
    m_Localized: "闸门 / 已锁定"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267319
    m_Localized: "撤离通道 / 已阻断"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267320
    m_Localized: "撤离通道 / 畅通"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267321
    m_Localized: "\u81ea\u6211\u9632\u5b88"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267322
    m_Localized: "\u5f00\u542f\u95f8\u95e8"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267323
    m_Localized: "\u9632\u5b88\u4e2d"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267324
    m_Localized: "迎战野兽 [G / RB]"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267325
    m_Localized: "检查绳索 [G / RB]"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267326
    m_Localized: "收回绳索 [G / RB]"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267327
    m_Localized: "检查货车 [G / RB]"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267328
    m_Localized: "告知货车位置 [G / RB]"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267329
    m_Localized: "查看爪痕 [G / RB]"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267330
    m_Localized: "系好引导绳 [G / RB]"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267331
    m_Localized: "带测路人撤离 [G / RB]"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267332
    m_Localized: "加固木板 [G / RB]"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267333
    m_Localized: "询问测路人 [G / RB]"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267334
    m_Localized: "开启闸门 [G / RB]"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267335
    m_Localized: "测路人：终于安全了。我放错了路标，我会亲手拆掉。"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267336
    m_Localized: "救援成功：测路人已到达撤离点。他会拆除误导人的旧路标。"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267337
    m_Localized: "测路人：野兽堵在闸门口！把它引向侧铃架。"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267338
    m_Localized: "测路人：你走得太远了！回来带我去撤离点。"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267339
    m_Localized: "撤离受阻：把野兽引向侧铃架，远离闸门。"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267340
    m_Localized: "护送暂停：返回测路人身边，再带他前往撤离点。"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267341
    m_Localized: "测路人：请带我穿过闸门。我会在这块踏板上等你。"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267342
    m_Localized: "测路人：保持闸门敞开，我就在你身后。"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267343
    m_Localized: "先穿过打开的闸门，测路人正等你带路。"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267344
    m_Localized: "测路人：停下！下面那块木板撑不住你！"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267345
    m_Localized: "测路人：上面那块木板能承受两个人。我的路标误导了你，我会把它拆掉。"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267346
    m_Localized: "测路人：上面的木板固定好了，我现在能过去——别把我丢在这里。"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267347
    m_Localized: "测路人：下面的木板断了！来问我上面哪条路安全。"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267348
    m_Localized: "野兽撞击：你被击退到撤离点。闸门仍开着，请选择更安全的路线。"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267349
    m_Localized: "正面路线：指挥 ORK 小队迎战，或把野兽引到侧铃架。"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267350
    m_Localized: "正面路线：指挥 ORK 小队迎战，也可以检查附近足迹寻找其他方案。"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267351
    m_Localized: "野兽已被击败：三名队员清理了内侧通道。现在可以打开闸门。"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267352
    m_Localized: "[F / LB] 在此铃架放下铜铃，确定铃声来源。"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267353
    m_Localized: "将铜铃搬到入口铃架或侧廊铃架。只能在标记的铃架放下。"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267354
    m_Localized: "[G / RB] 查看断裂的铃绳。"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267355
    m_Localized: "[G / RB] 收起可用的绳段，留作护送引绳。"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267356
    m_Localized: "你已找回可用的绳段，可以交给测路人。"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267357
    m_Localized: "[G / RB] 检查被遗弃的骡车。"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267358
    m_Localized: "车辙通向内室闸门。"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267359
    m_Localized: "[G / RB] 检查野兽留下的爪痕。"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267360
    m_Localized: "爪痕通向侧铃架，但野兽仍需要听见铃声才会追过去。"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267361
    m_Localized: "移动"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267362
    m_Localized: "上"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267363
    m_Localized: "右"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267364
    m_Localized: "下"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267365
    m_Localized: "左"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267366
    m_Localized: "确认移动"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267367
    m_Localized: "取消移动"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267368
    m_Localized: "测路人：地图工具已找回。我在旧路标处竖起了核实过的返程指示。"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267369
    m_Localized: "测路人：地图工具找回来了。我会回旧路标处标明正确路线。"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267370
    m_Localized: "测路人：错误路标已经拆下。你找到了我的骡车，我去取回地图工具。"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267371
    m_Localized: "测路人：是我标错了方向。那块误导人的路牌已拆下。"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267372
    m_Localized: "观察：废弃的骡车曾被拖到闸门，车辙通向内室。"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267373
    m_Localized: "观察：铃绳被割断，断口还留着一个粗糙的绳结。"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267374
    m_Localized: "观察：爪痕转向侧边铃架，而不是撤退点。"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267375
    m_Localized: "安全路线已标记：测路人用核实过的指示替换了错误路标。"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267376
    m_Localized: "地图工具已取回：测路人正返回旧路标处标记安全路线。"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267377
    m_Localized: "路线已纠正：[G / RB] 告诉测路人骡车的位置，或暂时离开。"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267378
    m_Localized: "路线已纠正：靠近测路人时，可以告诉他骡车的位置。"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267379
    m_Localized: "路线已纠正：测路人正返回骡车取回地图工具。"
    m_Metadata:
      m_Items: []
  - m_Id: 94572955267380
    m_Localized: "路线已纠正：测路人亲手拆掉了错误的方向标记。"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
